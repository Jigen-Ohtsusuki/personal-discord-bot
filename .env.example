# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# MissJey's Server ID (For instant slash command sync & private bot mode)
# Right-click your server in Discord and select 'Copy Server ID'
GUILD_ID=

# Optional: YouTube Data API v3 Key (Leave blank to use the built-in Zero-Quota scraper/probe engine)
# Get a free key at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# How frequently (in seconds) the bot checks YouTube channels (default: 120 seconds / 2 minutes)
CHECK_INTERVAL_SECONDS=120

# Database path (SQLite)
DATABASE_PATH=bot_database.db

# --- Real-Time Push Notifications (Google WebSub / PubSubHubbub) ---
# For instant notifications (< 5 seconds) without polling delay:
# Set CALLBACK_URL to your public bot URL (e.g., https://your-bot.onrender.com or a Cloudflare Tunnel)
# Leave blank to use background polling.
CALLBACK_URL=
WEBHOOK_PORT=8080
WEBHOOK_SECRET=my_secret_key_123
